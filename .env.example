# Database
DATABASE_URL=

# Auth
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m

# Media (ImageKit)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Socket server (set NEXT_PUBLIC_SOCKET_URL to the production URL for deployment)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Sentry — https://sentry.io
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Enable WebSocket event tracing in browser console (true/false)
NEXT_PUBLIC_WS_TRACE=false
